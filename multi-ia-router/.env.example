# Copier ce fichier en ".env" puis remplir. Ne jamais committer ".env".

# AnythingLLM : Paramètres → Outils → API développeur → Générer une clé
ANYTHINGLLM_API_KEY=

# Google Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (uniquement si agents.claude.type = claude_api)
ANTHROPIC_API_KEY=

# Optionnel : forcer le mode simulation (aucun appel réel)
# ROUTER_MOCK=1
